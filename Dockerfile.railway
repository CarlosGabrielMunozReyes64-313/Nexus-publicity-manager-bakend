FROM python:3.12-slim AS wheels
WORKDIR /build
COPY pyproject.toml requirements.lock ./
COPY app ./app
RUN pip wheel --no-cache-dir --wheel-dir /wheels -c requirements.lock .

FROM python:3.12-slim
WORKDIR /srv/nexus

COPY --from=wheels /wheels /wheels
RUN pip install --no-cache-dir /wheels/* \
    && rm -rf /wheels \
    && useradd --uid 10001 --create-home nexus

COPY app ./app
COPY migraciones ./migraciones
COPY migraciones_bajas ./migraciones_bajas
COPY scripts ./scripts
COPY sql ./sql
COPY alembic.ini alembic_bajas.ini ./
COPY Procfile.railway ./Procfile

USER nexus
CMD ["honcho", "start"]
