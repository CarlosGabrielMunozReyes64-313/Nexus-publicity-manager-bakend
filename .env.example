APP_ENV=development
APP_URL=http://localhost:8000
DATABASE_URL=postgresql://nexus_app:CAMBIAR@localhost:5432/nexus
# Base secundaria de bajas (en Railway: ${{Postgres-3qtE.DATABASE_URL}} en el servicio del
# backend). Vacía: las bajas funcionan igual y quedan pendientes de copiar.
UNSUBSCRIBE_DATABASE_URL=
# Origen público de los enlaces «Rechazar / Darme de baja» (sin ruta). Vacío: APP_URL.
BAJA_URL_PUBLICA=
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
CLAVE_CIFRADO=
SESION_SECRETO=
ADMIN_CORREO=admin@nexusinnovacion.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DOMINIO_PERMITIDO=nexusinnovacion.com
GMAIL_CUENTA_ENVIO=
AUTH_DEV_BYPASS=true
ANTHROPIC_API_KEY=
CLAUDE_MODELO_LIGERO=claude-haiku-5-5
CLAUDE_MODELO_MAYOR=claude-sonnet-5-5
CLAUDE_PRECIOS_JSON={}
COSTO_BUSQUEDA_WEB_USD=0.01
TOPE_USD_POR_TAREA=0.50
TOPE_MENSUAL_USD=30
HUNTER_API_KEY=
GOOGLE_CUENTA_SERVICIO_JSON=
GA4_PROPIEDAD_ID=
SEARCH_CONSOLE_SITIO=
FORMULARIO_WEBHOOK_SECRETO=
DIAGNOSTICO_URL=https://nexusinnovacion.com/diagnostico
TASA_COP_POR_USD=4000
UMBRAL_CALIFICADO=70

# Gemini opcional: mantener claude conserva el proveedor anterior.
AGENTE_PROVEEDOR=claude
GEMINI_API_KEY=
GEMINI_MODELO=gemini-3.5-flash-lite
GEMINI_PRECIOS_JSON={"gemini-3.5-flash-lite":{"entrada":0.30,"salida":2.50}}
GEMINI_COSTO_BUSQUEDA_USD=0.014
# Activar solo con clave y trabajador configurados.
DESCUBRIMIENTO_AUTOMATICO=false
DESCUBRIMIENTO_LIMITE_DIARIO=20
DESCUBRIMIENTO_HORA=8
